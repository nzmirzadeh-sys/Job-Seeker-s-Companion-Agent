# ── Copy this file to .env and fill in the values ──────────────────────────

# Django secret key — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-use-a-long-random-string-here

# PostgreSQL password (used by both db and backend services)
DB_PASSWORD=jobmatch_secret

# Comma-separated allowed hosts (include your domain/IP for production)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Comma-separated trusted origins for CSRF (must include your frontend URL)
CSRF_TRUSTED_ORIGINS=http://localhost,https://yourdomain.com

# Nginx listen port (default 80)
PORT=80

# ── LLM API Keys (optional — falls back to rule-based engine if not set) ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
