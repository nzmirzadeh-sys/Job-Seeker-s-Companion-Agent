# Copy to .env (local) or set as real environment variables (Docker / server).
# NEVER commit the real .env — it is already in .dockerignore.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=your-domain.com,localhost
CSRF_TRUSTED_ORIGINS=https://your-frontend.com,http://localhost:3000

# Database: leave empty for SQLite, or use one of:
DATABASE_URL=postgres://user:password@db:5432/dbname
# DB_NAME=... DB_USER=... DB_PASSWORD=... DB_HOST=db DB_PORT=5432

# All model-backed features use OpenRouter. Credentials are backend-only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
LLM_TIMEOUT=45

GUNICORN_WORKERS=3

# Where uploaded datasets are stored (mount a persistent volume here in Docker)
MEDIA_ROOT=/app/media
